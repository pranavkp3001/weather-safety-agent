# WeatherBuddy Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Application ──────────────────────────────────────────────
APP_NAME=MediBuddy Weather-Advisory Support Bot
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ─── LLM Provider ─────────────────────────────────────────────
# Default: "mock" (uses built-in MockLLMClient, no API key needed)
# Options: "mock", "gemini"
LLM_PROVIDER=mock

# Model name when using Gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (only needed if LLM_PROVIDER is not "mock")
# Get a Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Reserved for future providers (not currently implemented)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Weather Service (Open-Meteo) ─────────────────────────────
# Free, no API key required
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT=10.0

# ─── Policy Configuration ─────────────────────────────────────
# Path to SOPs YAML file (relative to backend/app/)
SOPS_FILE_PATH=backend/app/policies/sops.yaml

# ─── Session ──────────────────────────────────────────────────
SESSION_TTL_MINUTES=60